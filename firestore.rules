rules_version = '2';

// Drew Arcade — every read and write goes through the Next.js server, which
// uses the Firebase Admin SDK and bypasses these rules entirely. No browser
// should ever touch this database directly: wallets, escrow and the secret
// words for live duels all live here.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// IMPORTANT: this denies the web-SDK fallback too. Set FIREBASE_SERVICE_ACCOUNT
// before deploying these rules, or the app loses database access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
